{
  "name": "pgx-watch",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "scan": "tsx backend/cli.ts",
    "test": "tsx --test backend/*.test.ts",
    "typecheck": "tsc --noEmit",
    "backend": "tsx backend/server.ts",
    "build": "npm run typecheck && npm --prefix frontend run build"
  },
  "dependencies": {
    "@animahealth/adk": "0.6.0",
    "zod": "^3.25.0",
    "openai": "^5.0.0",
    "express": "^5.1.0",
    "better-sqlite3": "^12.0.0"
  },
  "devDependencies": {
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "@types/node": "^22.0.0",
    "@types/express": "^5.0.0",
    "@types/better-sqlite3": "^7.6.0"
  }
}
